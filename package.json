{
  "name": "@nexconn/chatui",
  "version": "26.2.5",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NexconnAI-Dev/nexconn-chatui-web.git"
  },
  "bugs": {
    "url": "https://github.com/NexconnAI-Dev/nexconn-chatui-web/issues"
  },
  "scripts": {
    "build:apidoc": "typedoc && typedoc --options typedoc.markdown.json && node scripts/postprocess-apidoc.mjs",
    "typecheck:lib": "tsc -p tsconfig.lib.json --noEmit",
    "build": "npm run typecheck:lib && vite build",
    "release": "MODE=production npm run build",
    "lint:lib": "npm run typecheck:lib && eslint --ext .ts,.mjs src scripts",
    "lint": "npm run lint:lib",
    "fix": "eslint --ext .ts,.mjs src scripts --fix"
  },
  "engines": {
    "node": ">=18.12.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^5.1.0",
    "@types/node": "~18.14.6",
    "@typescript-eslint/eslint-plugin": "^5.36.1",
    "@typescript-eslint/parser": "^5.36.1",
    "eslint": "^7.16.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-airbnb-typescript": "^17.0.0",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^4.2.1",
    "rollup": "^2.35.1",
    "rollup-plugin-dts": "^2.0.1",
    "sass": "^1.59.3",
    "typedoc": "^0.22.18",
    "typedoc-plugin-markdown": "3.12.1",
    "typedoc-theme-category": "^1.0.7",
    "typescript": "~4.6.2",
    "vite": "^4.1.4"
  },
  "dependencies": {
    "@nexconn/chat": "^26.2.1",
    "@nexconn/engine": "^26.2.1",
    "lit": "^3.3.2"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
}
